{
  "manifest_version": 3,
  "name": "CareerTrack Job Clipper",
  "version": "1.0.0",
  "description": "One-click job saving and application tracking with Kanban board and deadline reminders",
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://*.indeed.com/*",
    "https://internshala.com/*",
    "https://*.internshala.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "CareerTrack Job Clipper"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/*",
        "https://*.indeed.com/*",
        "https://internshala.com/*",
        "https://*.internshala.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "board.html",
        "board.js",
        "board.css",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}